{
  "manifest_version": 3,
  "name": "Dealflow: add people",
  "short_name": "Dealflow",
  "version": "1.0.0",
  "description": "Add the person on the LinkedIn profile or email you're looking at to your firm's Dealflow, after checking the details.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Add this person to Dealflow",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
