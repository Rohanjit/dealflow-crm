# Copy to .env and adjust. Everything is optional.

# Port Dealflow listens on (http://localhost:8000 by default)
# DEALFLOW_PORT=8000

# Time zone for daily backups and timestamps
# TZ=Asia/Kolkata

# Postgres (run with: docker compose --profile postgres up -d)
# POSTGRES_PASSWORD=pick-a-strong-password
# DATABASE_URL=postgres://dealflow:pick-a-strong-password@db:5432/dealflow

# If you put Dealflow behind HTTPS on your own domain:
# DJANGO_ALLOWED_HOSTS=crm.yourfirm.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.yourfirm.com
# DEALFLOW_SECURE_COOKIES=1
