# Copy to .env and adjust. Everything is optional.

# HTTPS for a team (recommended): the name people will open, then run
#   docker compose --profile https up -d
# Caddy gets a certificate from Let's Encrypt (ports 80 and 443 must reach this server at that name).
# Everything else (secure cookies, HSTS, allowed names) follows from this one setting.
# DEALFLOW_DOMAIN=crm.yourfirm.com
# DEALFLOW_ACME_EMAIL=it@yourfirm.com
# For a name only your office network knows, use Caddy's own certificate authority instead, and
# install its root certificate on each computer (docs/https.md):
# DEALFLOW_TLS=internal

# Without a domain, Dealflow answers only on this computer, at http://localhost:8000.
# DEALFLOW_PORT=8000
# DEALFLOW_BIND=127.0.0.1   (0.0.0.0 would open plain http to the network: use the https profile)

# Time zone for daily backups and timestamps
# TZ=Asia/Kolkata

# Postgres (add --profile postgres). The database sits on a private network with no internet access.
# POSTGRES_PASSWORD=pick-a-strong-password
# DATABASE_URL=postgres://dealflow:pick-a-strong-password@db:5432/dealflow

# Your own proxy instead of the bundled Caddy: set DEALFLOW_DOMAIN as above (it turns on https
# cookies, HSTS and trust in the proxy's headers), or each part by hand:
# DJANGO_ALLOWED_HOSTS=crm.yourfirm.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://crm.yourfirm.com
# DEALFLOW_HTTPS=1
# DEALFLOW_BEHIND_PROXY=1
# DEALFLOW_PROXY_HOPS=1   (proxies in front of the app; the client's address is read from that end)

# Public demo site: sample data only, "Continue as guest" on the sign-in page, no set-up,
# and the sample is reloaded every day by the scheduler. Never set this on a firm's own install.
# DEALFLOW_DEMO=1

# Where the encrypted audit log is kept (defaults to the audit folder inside the data folder).
# DEALFLOW_AUDIT_DIR=/data/audit

# Virus scanner (ClamAV's clamd), "host:port" or a socket path. Docker Compose sets this to its own
# clamav service. Without a scanner that answers, uploads are refused.
# DEALFLOW_CLAMD=clamav:3310
